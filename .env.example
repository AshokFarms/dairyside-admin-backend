# ─────────────────────────────────────────────────────────────
#  DairySide Admin API — environment
#  Copy to `.env` and fill in. Required vars are validated at startup
#  (config/env.js) — the process exits immediately if any are missing.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=5001
LOG_LEVEL=info

# MySQL (shared DairySide database) — REQUIRED
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=dairyside

# CORS — comma-separated admin panel origins allowed to call this API
ADMIN_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin auth seam (see middleware/adminGuard.js).
# Auth is OFF by default. Set to true AND provide ADMIN_UIDS to enforce
# authenticated + admin-role access on every /v1/admin route.
ADMIN_AUTH_ENABLED=false
# Comma-separated Firebase UIDs allowed to use the admin API (used when enabled).
ADMIN_UIDS=

# Rate limiting (defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
